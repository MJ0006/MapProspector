# Copy to .env and fill in what you have. Every module without a key switches itself off.

# Google Cloud key with "Places API (New)" (and optionally PageSpeed Insights API) enabled
GOOGLE_API_KEY=

# DataForSEO (optional): true per-point Maps SERP + keyword volume/CPC/difficulty
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Google OAuth client (optional) for Business Profile API + Search Console.
# Business Profile API needs Google's access approval; Search Console does not.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Extra AI engines for the AI visibility checker (optional). Claude runs via the `claude` CLI.
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# Outgoing email for reports / automations (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Where the database and client vaults live (default ./data)
DATA_DIR=
# Base URL used in share links / review-request links
PUBLIC_BASE_URL=http://127.0.0.1:8000
